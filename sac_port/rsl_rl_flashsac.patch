+# Copyright (c) 2021-2026, ETH Zurich and NVIDIA CORPORATION
+# All rights reserved.
+#
+# SPDX-License-Identifier: BSD-3-Clause
+
+"""FlashSAC actor and critic models (https://arxiv.org/abs/2604.04539).
+
+Ported from https://github.com/Holiday-Robot/FlashSAC (MIT License, Copyright (c) 2026 Holiday Robotics). The
+networks are written as ensembles of ``n`` members (``n = 1`` for the actor, ``n = 2`` for the twin critic) in plain
+PyTorch, without torch.compile, mixed precision or fused optimizers, so they run unchanged on CPU, CUDA and NPU.
+"""
+
+from __future__ import annotations
+
+import copy
+import math
+
+import torch
+import torch.nn as nn
+import torch.nn.functional as F
+from tensordict import TensorDict
+
+
+class _Linear(nn.Module):
+    """Bias-free linear layer for an ensemble; weight rows are kept at unit norm by :meth:`normalize`."""
+
+    def __init__(self, n: int, in_dim: int, out_dim: int) -> None:
+        super().__init__()
+        self.weight = nn.Parameter(torch.empty(n, out_dim, in_dim))
+        for w in self.weight.data:
+            nn.init.orthogonal_(w)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return torch.einsum("nbi,noi->nbo", x, self.weight)
+
+    def normalize(self) -> None:
+        self.weight.copy_(F.normalize(self.weight, dim=-1, eps=1e-8))
+
+
+class _BatchNorm(nn.Module):
+    """Batch normalization over the batch axis of ``[n, batch, dim]``; scale and shift are kept at norm sqrt(dim)."""
+
+    def __init__(self, n: int, dim: int, momentum: float = 0.01, eps: float = 1e-5) -> None:
+        super().__init__()
+        self.momentum = momentum
+        self.eps = eps
+        self.weight = nn.Parameter(torch.ones(n, dim))
+        self.bias = nn.Parameter(torch.zeros(n, dim))
+        self.register_buffer("running_mean", torch.zeros(n, dim))
+        self.register_buffer("running_var", torch.ones(n, dim))
+
+    def forward(self, x: torch.Tensor, training: bool) -> torch.Tensor:
+        if training:
+            mean = x.mean(dim=1, keepdim=True)
+            var = x.var(dim=1, unbiased=False, keepdim=True)
+            with torch.no_grad():
+                b = x.shape[1]
+                self.running_mean.lerp_(mean.squeeze(1), self.momentum)
+                self.running_var.lerp_(var.squeeze(1) * (b / (b - 1)), self.momentum)
+        else:
+            mean = self.running_mean.unsqueeze(1)
+            var = self.running_var.unsqueeze(1)
+        return (x - mean) * torch.rsqrt(var + self.eps) * self.weight.unsqueeze(1) + self.bias.unsqueeze(1)
+
+    def normalize(self) -> None:
+        sqsum = (self.weight * self.weight + self.bias * self.bias).sum(dim=-1, keepdim=True)
+        factor = math.sqrt(self.weight.shape[-1]) * torch.rsqrt(sqsum + 1e-8)
+        self.weight.mul_(factor)
+        self.bias.mul_(factor)
+
+
+class _RMSNorm(nn.Module):
+    """RMS normalization over the feature axis; the scale is kept at norm sqrt(dim)."""
+
+    def __init__(self, n: int, dim: int, eps: float = 1e-6) -> None:
+        super().__init__()
+        self.eps = eps
+        self.weight = nn.Parameter(torch.ones(n, dim))
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return x * torch.rsqrt(x.pow(2).mean(dim=-1, keepdim=True) + self.eps) * self.weight.unsqueeze(1)
+
+    def normalize(self) -> None:
+        sqsum = (self.weight * self.weight).sum(dim=-1, keepdim=True)
+        self.weight.mul_(math.sqrt(self.weight.shape[-1]) * torch.rsqrt(sqsum + 1e-8))
+
+
+class _Block(nn.Module):
+    """Inverted residual block: expand x4, BatchNorm, ReLU, project back, BatchNorm, ReLU, add the input."""
+
+    def __init__(self, n: int, dim: int, expansion: int = 4) -> None:
+        super().__init__()
+        self.w1 = _Linear(n, dim, dim * expansion)
+        self.norm1 = _BatchNorm(n, dim * expansion)
+        self.w2 = _Linear(n, dim * expansion, dim)
+        self.norm2 = _BatchNorm(n, dim)
+
+    def forward(self, x: torch.Tensor, training: bool) -> torch.Tensor:
+        y = F.relu(self.norm1(self.w1(x), training))
+        y = F.relu(self.norm2(self.w2(y), training))
+        return x + y
+
+
+class _Encoder(nn.Module):
+    """BatchNorm on the input, unit-norm embedding, residual blocks and a final RMSNorm."""
+
+    def __init__(self, n: int, in_dim: int, hidden_dim: int, num_blocks: int) -> None:
+        super().__init__()
+        self.in_norm = _BatchNorm(n, in_dim)
+        self.embed = _Linear(n, in_dim, hidden_dim)
+        self.blocks = nn.ModuleList([_Block(n, hidden_dim) for _ in range(num_blocks)])
+        self.out_norm = _RMSNorm(n, hidden_dim)
+
+    def forward(self, x: torch.Tensor, training: bool) -> torch.Tensor:
+        x = self.embed(self.in_norm(x, training))
+        for block in self.blocks:
+            x = block(x, training)
+        return self.out_norm(x)
+
+
+def _normalize_parameters(module: nn.Module) -> None:
+    """Project all unit-norm weights back onto their spheres (called after every optimizer step)."""
+    with torch.no_grad():
+        for m in module.modules():
+            if isinstance(m, (_Linear, _BatchNorm, _RMSNorm)):
+                m.normalize()
+
+
+def _obs_dim(obs: TensorDict, obs_groups: dict[str, list[str]], obs_set: str) -> tuple[list[str], int]:
+    groups = obs_groups[obs_set]
+    for group in groups:
+        assert len(obs[group].shape) == 2, "FlashSAC models only support 1D observations."
+    return groups, sum(obs[group].shape[-1] for group in groups)
+
+
+class FlashSACActorModel(nn.Module):
+    """FlashSAC actor: Tanh-squashed Gaussian policy with a bounded log-std and repeated exploration noise.
+
+    During collection (``stochastic_output=True``) each environment keeps its Gaussian noise sample for ``k`` steps,
+    with ``k`` drawn from a truncated Zeta distribution ``P(k) ~ k^-mu``, ``k <= noise_repeat_max``. Actions lie in
+    ``[-1, 1]`` and are passed to the environment as they are.
+    """
+
+    is_recurrent: bool = False
+
+    stateful_noise: bool = True
+    """Calling the actor stochastically advances the per-environment noise state."""
+
+    def __init__(
+        self,
+        obs: TensorDict,
+        obs_groups: dict[str, list[str]],
+        obs_set: str,
+        output_dim: int,
+        num_envs: int,
+        hidden_dim: int = 128,
+        num_blocks: int = 2,
+        log_std_min: float = -10.0,
+        log_std_max: float = 2.0,
+        noise_repeat_mu: float = 2.0,
+        noise_repeat_max: int = 16,
+        **kwargs,
+    ) -> None:
+        """Initialize the actor.
+
+        Args:
+            obs: Observation dictionary.
+            obs_groups: Dictionary mapping observation sets to lists of observation groups.
+            obs_set: Observation set to use for this model (e.g., "actor").
+            output_dim: Dimension of the action space.
+            num_envs: Number of environments, for the per-environment noise state.
+            hidden_dim: Width of the residual blocks.
+            num_blocks: Number of residual blocks.
+            log_std_min: Lower bound of the log standard deviation.
+            log_std_max: Upper bound of the log standard deviation.
+            noise_repeat_mu: Exponent of the Zeta distribution of noise repeat lengths.
+            noise_repeat_max: Longest noise repeat length.
+        """
+        super().__init__()
+        self.obs_groups, self.obs_dim = _obs_dim(obs, obs_groups, obs_set)
+        self.output_dim = output_dim
+        self.log_std_min = log_std_min
+        self.log_std_max = log_std_max
+
+        self.encoder = _Encoder(1, self.obs_dim, hidden_dim, num_blocks)
+        self.head = _Linear(1, hidden_dim, 2 * output_dim)  # mean rows, then log-std rows
+        self.head_bias = nn.Parameter(torch.zeros(2 * output_dim))
+        _normalize_parameters(self)
+
+        k = torch.arange(1, noise_repeat_max + 1, dtype=torch.float32)
+        pmf = k.pow(-noise_repeat_mu)
+        self.register_buffer("noise_repeat_cdf", torch.cumsum(pmf / pmf.sum(), 0), persistent=False)
+        self.register_buffer("noise", torch.zeros(num_envs, output_dim), persistent=False)
+        self.register_buffer("noise_steps_left", torch.zeros(num_envs, dtype=torch.long), persistent=False)
+        self._std = torch.zeros(output_dim)
+
+    def get_latent(self, obs: TensorDict) -> torch.Tensor:
+        return torch.cat([obs[group] for group in self.obs_groups], dim=-1)
+
+    def mean_std(self, x: torch.Tensor, training: bool) -> tuple[torch.Tensor, torch.Tensor]:
+        """Mean and standard deviation of the pre-Tanh Gaussian for flat observations ``x`` of shape [B, obs_dim]."""
+        out = self.head(self.encoder(x.unsqueeze(0), training))[0] + self.head_bias
+        mean, raw_log_std = out.split(self.output_dim, dim=-1)
+        log_std = self.log_std_min + (self.log_std_max - self.log_std_min) * 0.5 * (1 + torch.tanh(raw_log_std))
+        return mean, log_std.exp()
+
+    def sample(self, x: torch.Tensor, training: bool) -> tuple[torch.Tensor, torch.Tensor]:
+        """Reparameterized action sample and its log-probability (with the Tanh correction), shapes [B, A] and [B]."""
+        mean, std = self.mean_std(x, training)
+        eps = torch.randn_like(mean)
+        raw = mean + std * eps
+        log_prob = -0.5 * eps.pow(2) - std.log() - 0.5 * math.log(2 * math.pi)
+        # log(1 - tanh(x)^2) in a numerically safe form
+        log_prob = log_prob - 2.0 * (math.log(2.0) - raw - F.softplus(-2.0 * raw))
+        return torch.tanh(raw), log_prob.sum(dim=-1)
+
+    def forward(
+        self, obs: TensorDict, stochastic_output: bool = False, env_ids: slice | torch.Tensor | None = None, **kwargs
+    ) -> torch.Tensor:
+        """Act with running BatchNorm statistics.
+
+        Args:
+            obs: Observation dictionary.
+            stochastic_output: If True, add the repeated exploration noise; otherwise return the mean action.
+            env_ids: Environments the observations belong to, for the noise state. Defaults to all environments.
+
+        Returns:
+            Actions in [-1, 1].
+        """
+        mean, std = self.mean_std(self.get_latent(obs), training=False)
+        self._std = std
+        if not stochastic_output:
+            return torch.tanh(mean)
+        ids = slice(None) if env_ids is None else env_ids
+        left = self.noise_steps_left[ids]
+        renew = left <= 0
+        u = torch.rand(left.shape, device=left.device)
+        new_k = (self.noise_repeat_cdf <= u.unsqueeze(-1)).sum(dim=-1) + 1
+        noise = torch.where(renew.unsqueeze(-1), torch.randn_like(mean), self.noise[ids])
+        self.noise[ids] = noise
+        self.noise_steps_left[ids] = torch.where(renew, new_k.clamp(max=len(self.noise_repeat_cdf)), left) - 1
+        return torch.tanh(mean + std * noise)
+
+    @property
+    def output_std(self) -> torch.Tensor:
+        return self._std
+
+    def reset(self, dones: torch.Tensor | None = None, hidden_state=None) -> None:
+        pass
+
+    def as_jit(self) -> nn.Module:
+        """Return a version of the model compatible with Torch JIT export."""
+        return _TorchFlashSACActor(self)
+
+    def as_onnx(self, verbose: bool = False) -> nn.Module:
+        """Return a version of the model compatible with ONNX export."""
+        return _OnnxFlashSACActor(self, verbose)
+
+
+class FlashSACCriticModel(nn.Module):
+    """FlashSAC twin critic: two categorical (distributional) Q-networks evaluated as one ensemble."""
+
+    is_recurrent: bool = False
+
+    def __init__(
+        self,
+        obs: TensorDict,
+        obs_groups: dict[str, list[str]],
+        obs_set: str,
+        output_dim: int,
+        num_actions: int,
+        hidden_dim: int = 256,
+        num_blocks: int = 2,
+        num_bins: int = 101,
+        v_max: float = 5.0,
+        num_critics: int = 2,
+        **kwargs,
+    ) -> None:
+        """Initialize the critic.
+
+        Args:
+            obs: Observation dictionary.
+            obs_groups: Dictionary mapping observation sets to lists of observation groups.
+            obs_set: Observation set to use for this model (e.g., "critic").
+            output_dim: Unused; the value is categorical over ``num_bins`` atoms.
+            num_actions: Dimension of the action space (concatenated with observations).
+            hidden_dim: Width of the residual blocks.
+            num_blocks: Number of residual blocks.
+            num_bins: Number of value atoms, evenly spaced on [-v_max, v_max].
+            v_max: Value support bound, in units of the normalized reward.
+            num_critics: Ensemble size.
+        """
+        super().__init__()
+        self.obs_groups, self.obs_dim = _obs_dim(obs, obs_groups, obs_set)
+        self.v_max = v_max
+        self.encoder = _Encoder(num_critics, self.obs_dim + num_actions, hidden_dim, num_blocks)
+        self.head = _Linear(num_critics, hidden_dim, num_bins)
+        self.head_bias = nn.Parameter(torch.zeros(num_critics, num_bins))
+        self.register_buffer("bins", torch.linspace(-v_max, v_max, num_bins))
+        _normalize_parameters(self)
+
+    def get_latent(self, obs: TensorDict) -> torch.Tensor:
+        return torch.cat([obs[group] for group in self.obs_groups], dim=-1)
+
+    def forward(self, x: torch.Tensor, actions: torch.Tensor, training: bool) -> tuple[torch.Tensor, torch.Tensor]:
+        """Q-values [n, B] and atom log-probabilities [n, B, num_bins] for flat observations ``x`` of shape [B, D]."""
+        n = self.head_bias.shape[0]
+        h = torch.cat([x, actions], dim=-1).unsqueeze(0).expand(n, -1, -1)
+        logits = self.head(self.encoder(h, training)) + self.head_bias.unsqueeze(1)
+        log_probs = F.log_softmax(logits, dim=-1)
+        return (log_probs.exp() * self.bins).sum(dim=-1), log_probs
+
+
+class _TorchFlashSACActor(nn.Module):
+    """Exportable deterministic FlashSAC actor (running BatchNorm statistics, Tanh of the mean)."""
+
+    def __init__(self, model: FlashSACActorModel) -> None:
+        super().__init__()
+        self.encoder = copy.deepcopy(model.encoder)
+        self.head = copy.deepcopy(model.head)
+        self.head_bias = nn.Parameter(model.head_bias.detach().clone(), requires_grad=False)
+        self.output_dim = model.output_dim
+        self.input_size = model.obs_dim
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        out = self.head(self.encoder(x.unsqueeze(0), False))[0] + self.head_bias
+        return torch.tanh(out[..., : self.output_dim])
+
+    @torch.jit.export
+    def reset(self) -> None:
+        pass
+
+
+class _OnnxFlashSACActor(_TorchFlashSACActor):
+    """Exportable FlashSAC actor for ONNX."""
+
+    is_recurrent: bool = False
+
+    def __init__(self, model: FlashSACActorModel, verbose: bool) -> None:
+        super().__init__(model)
+        self.verbose = verbose
+
+    def get_dummy_inputs(self) -> tuple[torch.Tensor]:
+        return (torch.zeros(1, self.input_size),)
+
+    @property
+    def input_names(self) -> list[str]:
+        return ["obs"]
+
+    @property
+    def output_names(self) -> list[str]:
+        return ["actions"]
